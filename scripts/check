#!/bin/sh
# Static checks on the marketplace. Needs only sh and jq. Writes nothing.
set -eu
cd "$(dirname "$0")/.."
fail=0
err() { echo "error: $*" >&2; fail=1; }

jq -e '.name and (.plugins | length > 0)' .claude-plugin/marketplace.json >/dev/null || err "marketplace.json invalid"

for dir in plugins/*/; do
  name=$(basename "$dir")
  jq -e --arg n "$name" '.name == $n and .description and .version' "$dir/.claude-plugin/plugin.json" >/dev/null \
    || err "$name: plugin.json invalid or name differs from the folder"
  jq -e --arg n "$name" '.plugins[] | select(.name == $n and .source == "./plugins/" + $n)' .claude-plugin/marketplace.json >/dev/null \
    || err "$name: not listed in marketplace.json"
  for f in "$dir"agents/*.md "$dir"skills/*/SKILL.md; do
    [ -f "$f" ] || continue
    [ "$(sed -n 1p "$f")" = "---" ] || err "$f: missing frontmatter"
    grep -q '^name: ' "$f" && grep -q '^description: ' "$f" || err "$f: name or description missing"
  done
  for f in "$dir"agents/*.md; do
    [ -f "$f" ] || continue
    grep -q '^model: ' "$f" && grep -q '^tools: ' "$f" || err "$f: model or tools missing"
  done
done

jq -r '.plugins[].name' .claude-plugin/marketplace.json | while read -r n; do
  [ -d "plugins/$n" ] || { echo "error: $n listed but plugins/$n is missing" >&2; exit 1; }
done || fail=1

[ "$fail" = 0 ] && echo "marketplace OK"
exit "$fail"
